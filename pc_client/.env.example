# Willy PC Client Configuration

# URL to Central Server Hub (WebSocket endpoint)
# Production Cloud Server: wss://truewilly.com/willy/ws/devices
# Local Server: ws://localhost:8000/ws/devices
WILLY_SERVER_URL=wss://truewilly.com/willy/ws/devices

# Security Token (must match Server token)
WILLY_REMOTE_TOKEN=change-me-to-a-long-random-token

# Optional Custom Name for this PC
# WILLY_PC_NAME=Hari-Gaming-Laptop

# Live telemetry interval in seconds (default 2; each beat costs ~30 ms of CPU)
# WILLY_HEARTBEAT_SEC=2

# Read due reminders aloud on this PC as well as showing a pop-up (default true)
# WILLY_SPEAK_REMINDERS=true
