# Willy / Win-Assist Environment Configuration

# -------------------------------------------------------------
# LLM & STT PROVIDER CONFIGURATION
# -------------------------------------------------------------
# Choose primary LLM provider: "groq" (sub-second latency) or "gemini" (free & powerful)
LLM_PROVIDER=groq
STT_PROVIDER=groq

# Groq API Configuration (Fastest STT Whisper-large-v3 and Llama-3.3-70b)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API Configuration (Alternative / Generous Free Tier - https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Configuration (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# -------------------------------------------------------------
# WAKE WORD & AUDIO SETTINGS
# -------------------------------------------------------------
# Wake words / triggers (comma-separated, case-insensitive)
WAKE_WORDS=willy,willie,hey willy,hey willie,willy wake up

# Baseline audio RMS energy threshold for speech onset (auto-calibrates dynamically on startup)
ENERGY_THRESHOLD=0.025

# Enable active spectral noise reduction and bandpass filtering
NOISE_SUPPRESSION=true

# Minimum speech duration in seconds to discard transient noises (keyboard clicks, chair squeaks)
MIN_SPEECH_DURATION=0.20

# Seconds of silence after speech to trigger transcription (0.65s for snappy response)
SILENCE_DURATION=0.65

# Maximum speech recording duration in seconds
MAX_RECORDING_DURATION=20.0

# Session conversation timeout in seconds (after wake-up, user can speak follow-ups without saying wake word)
CONVERSATION_TIMEOUT=15.0

# -------------------------------------------------------------
# TEXT TO SPEECH (VOICE OUTPUT)
# -------------------------------------------------------------
# Voice provider: "edge-tts" (online neural natural voice) or "pyttsx3" (direct offline SAPI5)
TTS_PROVIDER=edge-tts

# Edge-TTS voice for English (Brian is natural, warm, and conversational)
TTS_VOICE=en-US-BrianMultilingualNeural

# Voice output rate modifier (e.g., "+14%", "default")
TTS_RATE=+14%

# -------------------------------------------------------------
# REMOTE GATEWAY & MOBILE ACCESS (SIRI / GOOGLE ASSISTANT)
# -------------------------------------------------------------
# Enable cloud relay bridge to EC2
ENABLE_CLOUD_RELAY=false

# Secret token for mobile web, Siri, and webhook authentication
WILLY_REMOTE_TOKEN=change-me-to-a-long-random-token

# -------------------------------------------------------------
# SYSTEM & SECURITY GUARDRAILS
# -------------------------------------------------------------
# Max execution timeout for PowerShell commands in seconds
POWERSHELL_TIMEOUT=30

# Enable debug verbose logs
DEBUG=false
