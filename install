#!/usr/bin/env bash
# Willy server installer.  Usage:   ./install            (asks a few questions)
#                                   ./install --yes --domain willy.example.com --ai gemini --ai-key AIza...
#
# Sets up the Willy hub (the brain your phone and PC talk to) on this Linux machine:
# Python environment, settings (.env, with a freshly generated access token), a service that
# starts at boot, optional HTTPS for your domain, and optionally the Willy server agent that
# lets you manage this machine by voice. Safe to run again: existing settings are kept.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT=8000
DOMAIN=""
AI_PROVIDER=""
AI_KEY=""
AI_MODEL=""
AI_BASE=""
SHARE=ask
OWNER_EMAIL=""
AGENT=ask
ASSUME_YES=0
SERVICES=1

while [ $# -gt 0 ]; do
  case "$1" in
    --port) PORT="$2"; shift 2 ;;
    --domain) DOMAIN="$2"; shift 2 ;;
    --ai) AI_PROVIDER="$2"; shift 2 ;;            # groq | gemini | openai | openrouter | custom
    --ai-key) AI_KEY="$2"; shift 2 ;;
    --ai-model) AI_MODEL="$2"; shift 2 ;;
    --ai-base-url) AI_BASE="$2"; shift 2 ;;
    --groq-key) AI_PROVIDER="groq"; AI_KEY="$2"; shift 2 ;;
    --share-usage) SHARE=yes; shift ;;
    --no-share-usage) SHARE=no; shift ;;
    --owner-email) OWNER_EMAIL="$2"; shift 2 ;;
    --agent) AGENT=yes; shift ;;
    --no-agent) AGENT=no; shift ;;
    --no-service) SERVICES=0; shift ;;
    -y|--yes) ASSUME_YES=1; shift ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Unknown option: $1 (try --help)" >&2; exit 2 ;;
  esac
done

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
step() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[33m! %s\033[0m\n' "$*" >&2; }
die()  { printf '\033[31mx %s\033[0m\n' "$*" >&2; exit 1; }
ask() { # ask "Question" default  -> echoes the answer
  if [ "$ASSUME_YES" = 1 ] || [ ! -t 0 ]; then echo "${2:-}"; return; fi
  local reply; read -r -p "$1 " reply || true; echo "${reply:-${2:-}}"
}

[ "$(uname -s)" = "Linux" ] || die "This installer is for Linux servers. On Windows download WillyPC.exe, on Android the .apk (see truewilly.com)."

SUDO=""
if [ "$(id -u)" -ne 0 ]; then
  command -v sudo >/dev/null 2>&1 && SUDO="sudo" || warn "Not root and no sudo: system packages and services can't be installed."
fi

# ----------------------------------------------------------------------------- packages
step "Checking Python and git"
pm=""
for candidate in apt-get dnf yum; do command -v "$candidate" >/dev/null 2>&1 && { pm="$candidate"; break; }; done
pkg_install() {
  [ -n "$pm" ] || die "Please install: $* (no supported package manager found)."
  case "$pm" in
    apt-get) $SUDO apt-get update -qq && $SUDO DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$@" ;;
    *) $SUDO "$pm" install -y -q "$@" ;;
  esac
}
python_ok() { command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3,10) else 1)'; }
if ! python_ok; then
  warn "Python 3.10+ not found; installing."
  case "$pm" in apt-get) pkg_install python3 python3-venv python3-pip ;; *) pkg_install python3 python3-pip ;; esac
fi
python_ok || die "Need Python 3.10 or newer (found: $(python3 --version 2>&1 || echo none))."
if [ "$pm" = "apt-get" ] && ! python3 -c 'import ensurepip, venv' >/dev/null 2>&1; then pkg_install python3-venv; fi
command -v curl >/dev/null 2>&1 || pkg_install curl
echo "Python $(python3 -c 'import platform; print(platform.python_version())')"

# ----------------------------------------------------------------------------- environment
step "Creating the Python environment (this takes a minute)"
cd "$DIR"
[ -d venv ] || python3 -m venv venv
./venv/bin/python -m pip install -q --upgrade pip
./venv/bin/python -m pip install -q -r server/requirements.txt
echo "Dependencies installed."

# ----------------------------------------------------------------------------- settings
step "Writing settings"
ENV_FILE="server/.env"
[ -f "$ENV_FILE" ] || { cp server/.env.example "$ENV_FILE"; chmod 600 "$ENV_FILE"; }
env_get() { grep -E "^$1=" "$ENV_FILE" | tail -1 | cut -d= -f2- || true; }
env_set() { # env_set KEY VALUE   (replaces the line, or appends)
  local tmp; tmp="$(mktemp)"
  grep -vE "^$1=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$1" "$2" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"; rm -f "$tmp"
}
TOKEN="$(env_get WILLY_REMOTE_TOKEN)"
if [ "${#TOKEN}" -lt 20 ] || [ "$TOKEN" = "change-me-to-a-long-random-token" ]; then
  TOKEN="$(./venv/bin/python -c 'import secrets; print(secrets.token_urlsafe(32))')"
  env_set WILLY_REMOTE_TOKEN "$TOKEN"
  echo "Generated a new access token."
fi
[ -n "$(env_get SERVER_PORT)" ] && PORT="$(env_get SERVER_PORT)"
env_set SERVER_PORT "$PORT"
# --- which AI the brain uses (any provider; you can change it later in the dashboard: Set up > AI brain)
choose_ai() {
  echo
  bold "Which AI should Willy think with?"
  echo "  1) Groq        free tier, fast         https://console.groq.com/keys"
  echo "  2) Google Gemini                       https://aistudio.google.com/apikey"
  echo "  3) OpenAI                              https://platform.openai.com/api-keys"
  echo "  4) OpenRouter  many models             https://openrouter.ai/keys"
  echo "  5) Other / local (Ollama, LM Studio, any OpenAI-compatible address)"
  echo "  6) Skip: I'll choose in the dashboard"
  case "$(ask 'Number [1-6]:' 6)" in
    1) AI_PROVIDER=groq ;; 2) AI_PROVIDER=gemini ;; 3) AI_PROVIDER=openai ;; 4) AI_PROVIDER=openrouter ;; 5) AI_PROVIDER=custom ;; *) AI_PROVIDER="" ; return ;;
  esac
  if [ "$AI_PROVIDER" = custom ]; then
    AI_BASE="$(ask 'Address, e.g. http://localhost:11434/v1 :' '')"
    AI_MODEL="$(ask 'Model name, e.g. llama3.1 :' '')"
    AI_KEY="$(ask 'API key (Enter if none):' '')"
  else
    AI_KEY="$(ask 'Paste your API key:' '')"
  fi
}
if [ -z "$AI_PROVIDER" ] && ! ./venv/bin/python -m server.cli ai-ready >/dev/null 2>&1 && [ "$ASSUME_YES" != 1 ] && [ -t 0 ]; then choose_ai; fi
if [ -n "$AI_PROVIDER" ]; then
  extra=()
  [ -z "$AI_MODEL" ] || extra+=(--model "$AI_MODEL")
  [ -z "$AI_BASE" ] || extra+=(--base-url "$AI_BASE")
  if ./venv/bin/python -m server.cli set-ai --provider "$AI_PROVIDER" --key "$AI_KEY" "${extra[@]}"; then
    :
  else
    warn "That AI setting didn't work (see above). Continuing: you can fix it in the dashboard under Set up > AI brain."
  fi
fi

# --- what the Willy project records (shown once, your choice)
if [ "$SHARE" = ask ]; then
  echo
  bold "About sharing with truewilly.com"
  cat <<'NOTICE'
  Signing in with Google goes through truewilly.com (so you need no Google setup of your own); it
  records your name and email. If you agree, this hub also checks in once a day with: its address, version,
  how many accounts and devices it has, the name of your AI provider, and counts of which features get
  used. It never sends your commands, replies, files, API keys or conversations.
  Turn it off any time with WILLY_TELEMETRY=off in server/.env. Email sign-in never touches truewilly.com.
NOTICE
  case "$(ask 'Share the daily check-in? [Y/n]' 'y')" in n|N|no|NO) SHARE=no ;; *) SHARE=yes ;; esac
fi
if [ "$SHARE" = no ]; then env_set WILLY_TELEMETRY off; else env_set WILLY_TELEMETRY on; fi
if [ -z "$DOMAIN" ]; then
  DOMAIN="$(ask 'Domain name for HTTPS, e.g. willy.example.com (Enter to skip; its DNS must already point here):' '')"
fi
[ -z "$OWNER_EMAIL" ] || env_set WILLY_OWNER_EMAIL "$OWNER_EMAIL"
if [ -n "$DOMAIN" ]; then env_set WILLY_PUBLIC_URL "https://$DOMAIN"; fi
mkdir -p server/data

# ----------------------------------------------------------------------------- services
write_unit() { # write_unit name description exec
  $SUDO tee "/etc/systemd/system/$1.service" >/dev/null <<UNIT
[Unit]
Description=$2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$(id -un)
WorkingDirectory=$DIR
ExecStart=$3
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
UNIT
}
HAVE_SYSTEMD=0
if [ "$SERVICES" = 1 ] && command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then HAVE_SYSTEMD=1; fi

step "Starting the Willy hub"
if [ "$HAVE_SYSTEMD" = 1 ]; then
  write_unit willy-hub "Willy hub" "$DIR/venv/bin/python -m server.main"
  $SUDO systemctl daemon-reload
  $SUDO systemctl enable --now willy-hub >/dev/null 2>&1
  $SUDO systemctl restart willy-hub
else
  warn "No systemd here: starting the hub in the background (it won't survive a reboot)."
  nohup "$DIR/venv/bin/python" -m server.main >"$DIR/server/data/hub.log" 2>&1 &
fi
ok=0
for _ in $(seq 1 40); do
  curl -fsS "http://127.0.0.1:$PORT/health" >/dev/null 2>&1 && { ok=1; break; }
  sleep 1
done
[ "$ok" = 1 ] || die "The hub didn't answer on port $PORT. Look at: journalctl -u willy-hub -n 50  (or server/data/hub.log)"
echo "Hub is running on port $PORT."

# ----------------------------------------------------------------------------- HTTPS
URL="http://$(hostname -I 2>/dev/null | awk '{print $1}'):$PORT"
if [ -n "$DOMAIN" ]; then
  step "Setting up HTTPS for $DOMAIN"
  if ! command -v caddy >/dev/null 2>&1 && [ "$pm" = "apt-get" ]; then
    pkg_install caddy >/dev/null 2>&1 || warn "Couldn't install Caddy from your distribution's packages."
  fi
  if command -v caddy >/dev/null 2>&1 && [ "$HAVE_SYSTEMD" = 1 ]; then
    if [ -s /etc/caddy/Caddyfile ] && ! grep -q "reverse_proxy 127.0.0.1:$PORT" /etc/caddy/Caddyfile; then
      $SUDO cp /etc/caddy/Caddyfile "/etc/caddy/Caddyfile.willy-backup.$(date +%s)"
    fi
    if ! grep -qs "^$DOMAIN" /etc/caddy/Caddyfile 2>/dev/null; then
      printf '\n%s {\n\treverse_proxy 127.0.0.1:%s\n}\n' "$DOMAIN" "$PORT" | $SUDO tee -a /etc/caddy/Caddyfile >/dev/null
    fi
    $SUDO systemctl enable --now caddy >/dev/null 2>&1 || true
    $SUDO systemctl reload caddy 2>/dev/null || $SUDO systemctl restart caddy
    URL="https://$DOMAIN"
    echo "Caddy fetches the certificate by itself; ports 80 and 443 must be open to the internet."
  else
    warn "Install any web server that proxies $DOMAIN to 127.0.0.1:$PORT with HTTPS. With Caddy, the whole config is:"
    printf '\n    %s {\n        reverse_proxy 127.0.0.1:%s\n    }\n\n' "$DOMAIN" "$PORT"
    URL="https://$DOMAIN"
  fi
fi

# ----------------------------------------------------------------------------- server agent
if [ "$AGENT" = ask ]; then
  case "$(ask 'Also install the Willy server agent, so Willy can show and manage this machine (CPU/RAM, files, shell, updates)? [Y/n]' 'y')" in
    n|N|no|NO) AGENT=no ;; *) AGENT=yes ;;
  esac
fi
if [ "$AGENT" = yes ]; then
  step "Installing the server agent"
  AGENT_ID="server_$(hostname | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '_')"
  KEY="$(./venv/bin/python -m server.cli device-key --type server --id "$AGENT_ID" --name "$(hostname)")"
  touch .env; chmod 600 .env
  { grep -vE '^(WILLY_REMOTE_TOKEN|WILLY_HUB_WS|WILLY_SERVER_NAME)=' .env || true; } > .env.tmp
  printf 'WILLY_REMOTE_TOKEN=%s\nWILLY_HUB_WS=ws://127.0.0.1:%s/ws/devices\nWILLY_SERVER_NAME=%s\n' "$KEY" "$PORT" "$(hostname)" >> .env.tmp
  mv .env.tmp .env; chmod 600 .env
  if [ "$HAVE_SYSTEMD" = 1 ]; then
    write_unit willy-agent "Willy server agent" "$DIR/venv/bin/python -m server_agent.agent"
    $SUDO systemctl daemon-reload
    $SUDO systemctl enable --now willy-agent >/dev/null 2>&1
    $SUDO systemctl restart willy-agent
  else
    nohup "$DIR/venv/bin/python" -m server_agent.agent >"$DIR/server/data/agent.log" 2>&1 &
  fi
  echo "The agent connects as a device called '$(hostname)'."
fi

# ----------------------------------------------------------------------------- done
LINK="$(./venv/bin/python -m server.cli sign-in-link --url "$URL")"
CODE="$(./venv/bin/python -m server.cli link-code)"
echo
bold "Willy is running."
cat <<DONE

  1. Open this link in your browser. It signs you in as the owner (keep it private):
         $LINK

  2. In the dashboard, "Set up" shows a code that is good for one device at a time. Enter it, with the hub
     address, in the apps:
         Hub address:  $URL
         First code:   $CODE        (valid 10 minutes; "Set up" makes new ones)
     - Phone:   install the Willy app, Settings > Sign in with a code
     - Windows: run WillyPC.exe and fill in the same two boxes

  3. Optional: in "Set up" add an email and password, or use Sign in with Google on the login page.

  Downloads and guide:   https://truewilly.com
  Settings file:         $DIR/server/.env     Logs: journalctl -u willy-hub -f
DONE
./venv/bin/python -m server.cli ai-ready >/dev/null 2>&1 || warn "No AI chosen yet: open the dashboard and use Set up > AI brain (Willy can't answer questions until then)."
