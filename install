#!/usr/bin/env bash
# Willy Linux Client Monitor Installer
#
# Usage:
#   ./install                         (Interactive setup for monitoring this Linux system)
#   ./install --name "My Server"      (Specify a friendly device name)
#   ./install --hub https://...       (Connect to a custom Willy Hub, default is truewilly.com)
#   ./install --hub-server            (Self-host the Willy Central Hub on this machine instead)
#
# Sets up the Willy Client Monitor Agent on this Linux machine:
# Installs a lightweight Python environment (psutil, websockets), pairs with your Willy
# account, and registers a background systemd service so this machine's CPU, RAM, disk,
# files, processes, and terminal can be monitored remotely from your Willy mobile and PC apps.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODE="client" # "client" (default) or "hub"
HUB="https://truewilly.com/willy"
NAME=""
TOKEN=""
SERVICES=1
ASSUME_YES=0

# Hub server options (only used when --hub-server is specified)
PORT=8000
DOMAIN=""
AI_PROVIDER=""
AI_KEY=""
AI_MODEL=""
AI_BASE=""
SHARE=ask
OWNER_EMAIL=""
AGENT=no

while [ $# -gt 0 ]; do
  case "$1" in
    --client|--agent|--monitor) MODE="client"; shift ;;
    --hub-server|--server|--self-host) MODE="hub"; shift ;;
    --hub)
      if [ $# -gt 1 ] && [[ "$2" =~ ^https?:// ]]; then
        HUB="$2"; shift 2
      else
        MODE="hub"; shift
      fi
      ;;
    --name) NAME="$2"; shift 2 ;;
    --token) TOKEN="$2"; shift 2 ;;
    --no-service) SERVICES=0; shift ;;
    -y|--yes) ASSUME_YES=1; shift ;;
    # Hub server options
    --port) MODE="hub"; PORT="$2"; shift 2 ;;
    --domain) MODE="hub"; DOMAIN="$2"; shift 2 ;;
    --ai) MODE="hub"; AI_PROVIDER="$2"; shift 2 ;;
    --ai-key) MODE="hub"; AI_KEY="$2"; shift 2 ;;
    --ai-model) MODE="hub"; AI_MODEL="$2"; shift 2 ;;
    --ai-base-url) MODE="hub"; AI_BASE="$2"; shift 2 ;;
    --groq-key) MODE="hub"; AI_PROVIDER="groq"; AI_KEY="$2"; shift 2 ;;
    --share-usage) SHARE=yes; shift ;;
    --no-share-usage) SHARE=no; shift ;;
    --owner-email) OWNER_EMAIL="$2"; shift 2 ;;
    -h|--help)
      echo "Willy Linux Installer"
      echo
      echo "Client Monitor Mode (Default):"
      echo "  ./install                       Install monitor agent and pair with Willy"
      echo "  ./install --name <name>         Set friendly device name (default: hostname)"
      echo "  ./install --hub <url>           Set Hub URL (default: https://truewilly.com/willy)"
      echo "  ./install --no-service          Run without creating systemd service"
      echo "  ./install -y                    Non-interactive (use defaults)"
      echo
      echo "Self-Host Willy Central Hub:"
      echo "  ./install --hub-server          Install and host the central Willy Hub on this server"
      echo "  ./install --hub-server --port 8000 --domain willy.example.com"
      exit 0
      ;;
    *) echo "Unknown option: $1 (try --help)" >&2; exit 2 ;;
  esac
done

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
step() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[33m! %s\033[0m\n' "$*" >&2; }
die()  { printf '\033[31mx %s\033[0m\n' "$*" >&2; exit 1; }
ask() { # ask "Question" default  -> echoes the answer
  if [ "$ASSUME_YES" = 1 ] || [ ! -t 0 ]; then echo "${2:-}"; return; fi
  local reply; read -r -p "$1 " reply || true; echo "${reply:-${2:-}}"
}

[ "$(uname -s)" = "Linux" ] || die "This installer is for Linux systems. On Windows download WillyPC-windows.zip, on Android download Willy.apk (see truewilly.com)."

SUDO=""
if [ "$(id -u)" -ne 0 ]; then
  command -v sudo >/dev/null 2>&1 && SUDO="sudo" || warn "Not root and no sudo: system packages and services can't be installed."
fi

# ----------------------------------------------------------------------------- packages
step "Checking Python and system packages"
pm=""
for candidate in apt-get dnf yum pacman zypper; do command -v "$candidate" >/dev/null 2>&1 && { pm="$candidate"; break; }; done
pkg_install() {
  [ -n "$pm" ] || die "Please install: $* (no supported package manager found)."
  case "$pm" in
    apt-get) $SUDO apt-get update -qq && $SUDO DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$@" ;;
    dnf|yum) $SUDO "$pm" install -y -q "$@" ;;
    pacman)  $SUDO pacman -Sy --noconfirm "$@" ;;
    zypper)  $SUDO zypper --non-interactive in "$@" ;;
    *)       $SUDO "$pm" install -y "$@" ;;
  esac
}
find_python() {
  for py in python3.13 python3.12 python3.11 python3.10 python3; do
    if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3,10) else 1)' 2>/dev/null; then
      echo "$py"
      return 0
    fi
  done
  return 1
}
PY_BIN="$(find_python || true)"
if [ -z "$PY_BIN" ]; then
  warn "Python 3.10+ not found; attempting automatic installation."
  case "$pm" in
    apt-get) pkg_install python3 python3-venv python3-pip ;;
    dnf|yum) pkg_install python3.11 python3.11-pip || pkg_install python3 python3-pip ;;
    pacman)  pkg_install python python-pip ;;
    zypper)  pkg_install python311 python311-pip || pkg_install python3 python3-pip ;;
    *) pkg_install python3 python3-pip ;;
  esac
  PY_BIN="$(find_python || true)"
fi
[ -n "$PY_BIN" ] || die "Need Python 3.10 or newer (found: $(python3 --version 2>&1 || echo none)). On Amazon Linux/RHEL run: sudo dnf install -y python3.11 python3.11-pip"
if [ "$pm" = "apt-get" ] && ! "$PY_BIN" -c 'import ensurepip, venv' >/dev/null 2>&1; then pkg_install python3-venv; fi
echo "Using $($PY_BIN --version 2>&1) ($PY_BIN)"

write_unit() { # write_unit name description exec
  $SUDO tee "/etc/systemd/system/$1.service" >/dev/null <<UNIT
[Unit]
Description=$2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$(id -un)
WorkingDirectory=$DIR
ExecStart=$3
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT
}

HAVE_SYSTEMD=0
if [ "$SERVICES" = 1 ] && command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then HAVE_SYSTEMD=1; fi

# =============================================================================
# MODE: CLIENT MONITOR (Default)
# =============================================================================
if [ "$MODE" = "client" ]; then
  echo
  bold "======================================================================"
  bold "         Willy Client Monitor Installer for Linux                     "
  bold "======================================================================"
  echo "Setting up this machine to be monitored by Willy."
  echo "(Live CPU, RAM, disk, processes, files, remote terminal)"
  echo

  # 1. Environment
  step "Setting up monitor environment"
  cd "$DIR"
  [ -d venv ] || "$PY_BIN" -m venv venv
  ./venv/bin/python -m pip install -q --upgrade pip
  ./venv/bin/python -m pip install -q psutil websockets
  echo "Monitor dependencies ready (psutil, websockets)."

  # 2. Existing settings check
  EXISTING_TOKEN=""
  EXISTING_HUB=""
  EXISTING_NAME=""
  if [ -f .env ]; then
    EXISTING_TOKEN="$(grep -E '^WILLY_REMOTE_TOKEN=' .env 2>/dev/null | tail -1 | cut -d= -f2- || true)"
    EXISTING_HUB="$(grep -E '^WILLY_HUB_WS=' .env 2>/dev/null | tail -1 | cut -d= -f2- || true)"
    EXISTING_NAME="$(grep -E '^WILLY_SERVER_NAME=' .env 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  fi

  if [ -z "$NAME" ]; then
    DEFAULT_NAME="${EXISTING_NAME:-$(hostname)}"
    NAME="$(ask "Device name for this machine [$DEFAULT_NAME]:" "$DEFAULT_NAME")"
  fi

  NEED_PAIR=1
  if [ -n "$EXISTING_TOKEN" ] && [ -n "$EXISTING_HUB" ]; then
    echo "Found existing pairing for '$EXISTING_NAME' with $EXISTING_HUB."
    if [ "$ASSUME_YES" = 1 ]; then
      NEED_PAIR=0
    else
      REPAIR="$(ask "Do you want to re-pair with a new code? [y/N]:" "n")"
      case "$REPAIR" in
        y|Y|yes|YES) NEED_PAIR=1 ;;
        *) NEED_PAIR=0 ;;
      esac
    fi
  fi

  if [ "$NEED_PAIR" = 1 ]; then
    step "Connecting this machine to Willy"
    DEF_HUB="https://truewilly.com/willy"
    if [ -n "$EXISTING_HUB" ]; then
      DEF_HUB="$(echo "$EXISTING_HUB" | sed 's|^wss://|https://|;s|^ws://|http://|;s|/ws/devices$||')"
    fi
    if [ -z "$HUB" ] || [ "$HUB" = "https://truewilly.com/willy" ]; then
      HUB="$(ask "Willy Hub address [$DEF_HUB]:" "$DEF_HUB")"
    fi
    ./venv/bin/python -m server_agent.pair --hub "$HUB" --name "$NAME"
  fi

  # 3. Background service
  step "Starting Willy Client Monitor service"
  if [ "$HAVE_SYSTEMD" = 1 ]; then
    write_unit willy-agent "Willy Client Monitor Agent" "$DIR/venv/bin/python -m server_agent.agent"
    $SUDO systemctl daemon-reload
    $SUDO systemctl enable --now willy-agent >/dev/null 2>&1
    $SUDO systemctl restart willy-agent
    echo "Service 'willy-agent' is enabled and running."
  else
    warn "systemd not available; starting monitor in background via nohup."
    pkill -f "server_agent.agent" 2>/dev/null || true
    nohup "$DIR/venv/bin/python" -m server_agent.agent >"$DIR/agent.log" 2>&1 &
    echo "Monitor started in background (agent.log)."
  fi

  # 4. Completion
  echo
  bold "======================================================================"
  bold "       [✓] WILLY CLIENT MONITOR INSTALLED & CONNECTED!                "
  bold "======================================================================"
  echo
  echo "This Linux machine ('$NAME') is now live on Willy."
  echo "You can monitor and manage it from your Willy mobile or PC app:"
  echo "  • Live CPU, RAM, disk, load & uptime"
  echo "  • Remote file explorer (upload/download)"
  echo "  • Run terminal commands, restart services & check logs"
  echo
  if [ "$HAVE_SYSTEMD" = 1 ]; then
    echo "Check status : sudo systemctl status willy-agent"
    echo "View live log: sudo journalctl -u willy-agent -f"
    echo "Restart agent: sudo systemctl restart willy-agent"
  else
    echo "View live log: tail -f $DIR/agent.log"
  fi
  echo "======================================================================"
  exit 0
fi

# =============================================================================
# MODE: WILLY CENTRAL HUB (Self-hosted)
# =============================================================================
bold "======================================================================"
bold "         Willy Central Hub Server Installer                           "
bold "======================================================================"
echo "This mode installs the central Willy brain & hub server on this machine."
echo

step "Creating the Python environment (full hub requirements)"
cd "$DIR"
[ -d venv ] || "$PY_BIN" -m venv venv
./venv/bin/python -m pip install -q --upgrade pip
./venv/bin/python -m pip install -q -r server/requirements.txt
echo "Dependencies installed."

step "Writing settings"
ENV_FILE="server/.env"
[ -f "$ENV_FILE" ] || { cp server/.env.example "$ENV_FILE"; chmod 600 "$ENV_FILE"; }
env_get() { grep -E "^$1=" "$ENV_FILE" | tail -1 | cut -d= -f2- || true; }
env_set() {
  local tmp; tmp="$(mktemp)"
  grep -vE "^$1=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$1" "$2" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"; rm -f "$tmp"
}
TOKEN="$(env_get WILLY_REMOTE_TOKEN)"
if [ "${#TOKEN}" -lt 20 ] || [ "$TOKEN" = "change-me-to-a-long-random-token" ]; then
  TOKEN="$(./venv/bin/python -c 'import secrets; print(secrets.token_urlsafe(32))')"
  env_set WILLY_REMOTE_TOKEN "$TOKEN"
  echo "Generated a new access token."
fi
[ -n "$(env_get SERVER_PORT)" ] && PORT="$(env_get SERVER_PORT)"
env_set SERVER_PORT "$PORT"

if [ -n "$AI_PROVIDER" ]; then
  extra=()
  [ -z "$AI_MODEL" ] || extra+=(--model "$AI_MODEL")
  [ -z "$AI_BASE" ] || extra+=(--base-url "$AI_BASE")
  ./venv/bin/python -m server.cli set-ai --provider "$AI_PROVIDER" --key "$AI_KEY" "${extra[@]}" || true
fi

if [ "$SHARE" = no ]; then env_set WILLY_TELEMETRY off; else env_set WILLY_TELEMETRY on; fi
if [ -n "$DOMAIN" ]; then env_set WILLY_PUBLIC_URL "https://$DOMAIN"; fi
[ -z "$OWNER_EMAIL" ] || env_set WILLY_OWNER_EMAIL "$OWNER_EMAIL"
mkdir -p server/data

step "Starting the Willy hub"
if [ "$HAVE_SYSTEMD" = 1 ]; then
  write_unit willy-hub "Willy hub" "$DIR/venv/bin/python -m server.main"
  $SUDO systemctl daemon-reload
  $SUDO systemctl enable --now willy-hub >/dev/null 2>&1
  $SUDO systemctl restart willy-hub
else
  warn "No systemd here: starting the hub in the background (it won't survive a reboot)."
  nohup "$DIR/venv/bin/python" -m server.main >"$DIR/server/data/hub.log" 2>&1 &
fi

ok=0
for _ in $(seq 1 40); do
  curl -fsS "http://127.0.0.1:$PORT/health" >/dev/null 2>&1 && { ok=1; break; }
  sleep 1
done
[ "$ok" = 1 ] || die "The hub didn't answer on port $PORT. Look at: journalctl -u willy-hub -n 50  (or server/data/hub.log)"
echo "Hub is running on port $PORT."

URL="http://$(hostname -I 2>/dev/null | awk '{print $1}'):$PORT"
if [ -n "$DOMAIN" ]; then
  step "Setting up HTTPS for $DOMAIN"
  if ! command -v caddy >/dev/null 2>&1 && [ "$pm" = "apt-get" ]; then
    pkg_install caddy >/dev/null 2>&1 || warn "Couldn't install Caddy from your distribution's packages."
  fi
  if command -v caddy >/dev/null 2>&1 && [ "$HAVE_SYSTEMD" = 1 ]; then
    if [ -s /etc/caddy/Caddyfile ] && ! grep -q "reverse_proxy 127.0.0.1:$PORT" /etc/caddy/Caddyfile; then
      $SUDO cp /etc/caddy/Caddyfile "/etc/caddy/Caddyfile.willy-backup.$(date +%s)"
    fi
    if ! grep -qs "^$DOMAIN" /etc/caddy/Caddyfile 2>/dev/null; then
      printf '\n%s {\n\treverse_proxy 127.0.0.1:%s\n}\n' "$DOMAIN" "$PORT" | $SUDO tee -a /etc/caddy/Caddyfile >/dev/null
    fi
    $SUDO systemctl enable --now caddy >/dev/null 2>&1 || true
    $SUDO systemctl reload caddy 2>/dev/null || $SUDO systemctl restart caddy
    URL="https://$DOMAIN"
    echo "Caddy fetches certificate automatically; ports 80 and 443 must be reachable."
  fi
fi

echo
bold "======================================================================"
bold "         [✓] WILLY HUB INSTALLATION COMPLETE!                         "
bold "======================================================================"
echo
echo "Dashboard & Setup URL: ${URL}"
echo "Run setup wizard     : ./setup"
echo "======================================================================"
