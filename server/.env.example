# Willy Central Server Hub Configuration

# Host and Port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Security Token (shared between Server, PC Client, and Flutter Mobile)
# IMPORTANT: replace the default with a long random value. Anyone holding this token can
# control your PC, and the default is public. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WILLY_REMOTE_TOKEN=change-me-to-a-long-random-token

# Primary LLM Provider: 'groq' | 'gemini' | 'openai'
LLM_PROVIDER=groq

# Groq API Key (Free tier available at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3
# Tried in order when the main model hits its rate limit (on Groq's free tier each model has
# its own daily token quota, so this multiplies how many AI requests you get per day).
LLM_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Google Gemini API Key (Alternative provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Alternative provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Edge-TTS Neural Voice (TTS_RATE speeds speech up, e.g. +10%)
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+0%

# --- Realtime tuning ---
# Answer simple commands ("lock my pc", "volume 40", "what's my battery") instantly without the LLM.
FAST_PATH_ENABLED=true
# Seconds without a heartbeat before a connected device is shown offline.
DEVICE_STALE_SEC=20
# Seconds to wait for a device to finish a command.
DEVICE_COMMAND_TIMEOUT_SEC=20
# Optional: sent as `reasoning_effort` to reasoning models (e.g. "none" for faster Qwen3 on Groq).
# Leave empty if unsure; it is dropped automatically if the model rejects it.
LLM_REASONING_EFFORT=

# Timezone for reminders, alarms and the morning briefing (IANA name, e.g. Asia/Kolkata).
# Empty = use the timezone reported by your phone/PC (important when the server runs in UTC).
USER_TIMEZONE=

# Where reminders, alarms, telemetry and the activity log are stored (default: server/data).
# WILLY_DATA_DIR=

# --- Accounts (Google sign-in) ---
# Database for accounts and device keys. Empty = a SQLite file in the data folder (no setup).
# Any SQLAlchemy URL works, e.g. MariaDB/MySQL:  mysql+pymysql://user:password@host:3306/willy
WILLY_DATABASE_URL=
# Your Firebase project (console.firebase.google.com > Authentication > Google enabled).
# These are public client settings (from Project settings > Your apps > Web app), not secrets.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Who owns this hub: this Google account gets the admin role and the existing data.
# Required to use the admin features; nobody becomes owner just by signing in first.
WILLY_OWNER_EMAIL=
# closed (default): only the owner and WILLY_ALLOWED_EMAILS can sign in. open: anyone can
# sign up and gets a private space of their own (what a public Willy site uses).
WILLY_SIGNUP=closed
WILLY_ALLOWED_EMAILS=
# Public address of this hub (used in pairing links), e.g. https://truewilly.com/willy
WILLY_PUBLIC_URL=

# --- Which AI the brain uses ---
# Normally chosen by ./install or in the dashboard (Set up > AI brain, saved in the data folder). These .env
# values are only the starting point: LLM_PROVIDER = groq | gemini | openai | openrouter | custom.

# --- The Willy master (truewilly.com) ---
# Where this hub sends people to "Sign in with Google" when it has no Firebase of its own, and where it
# checks in once a day. Empty = never contact it (email and the owner link still work).
WILLY_BROKER_URL=https://truewilly.com/willy
# on/off: the daily check-in (address, version, device counts, AI provider name, feature usage counts).
# Never commands, files, conversations or keys. See server/registry.py.
WILLY_TELEMETRY=on
# Only on the Willy project's own master hub: serve the Google sign-in for other hubs and keep the registry.
WILLY_MASTER=
